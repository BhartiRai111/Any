DATABASE_URL="postgresql://boutique:boutique@localhost:5432/boutique"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Shown on the Contact page and in order emails
STORE_EMAIL="hello@willowandclay.example"
# Optional. When set, "Bank transfer" appears at checkout and these lines are shown after ordering
STORE_BANK_DETAILS="Account name: Willow & Clay|Bank: Example Bank|IBAN: XX00 0000 0000 0000"
# Razorpay (UPI, cards, net banking, wallets, EMI). Get test keys at dashboard.razorpay.com. Leave empty to hide online payment.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Secret you set when adding the webhook https://YOUR-SITE/api/razorpay/webhook (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=""

# Public address of the site, used in email links (password reset, invoices)
SITE_URL="http://localhost:3000"
# Email sending. Leave SMTP_HOST empty to print emails in the server log instead of sending them.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Willow & Clay <hello@willowandclay.example>"
# Delivery check. STORE_PIN is where parcels leave from. SERVICEABLE_PIN_PREFIXES (e.g. "22,11,40") limits delivery to PIN codes starting with those digits; empty means everywhere in India.
STORE_PIN="221001"
SERVICEABLE_PIN_PREFIXES=""
